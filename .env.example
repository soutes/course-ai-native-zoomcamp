# Copy to .env and fill in. .env is git-ignored and never shipped.

# --- Django ---
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Sao_Paulo

# SQLite by default. Point at Postgres with:
#   DATABASE_URL=postgres://user:pass@localhost:5432/weekly
DATABASE_URL=

# --- GitHub ---
# Personal Access Token with the `repo` scope: https://github.com/settings/tokens
GITHUB_USER=
GITHUB_TOKEN=
# Git emails used to filter your own commits in shared repos, comma separated.
GITHUB_EMAILS=

# Below this many commits a repo is noise, not portfolio.
TRIAGE_MIN_COMMITS=10

# --- LLM (runtime coaching, phase 4) ---
# OpenAI-compatible endpoint. Groq by default.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
